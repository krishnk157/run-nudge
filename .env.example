# Neon Postgres. Use the *pooled* connection string (host contains "-pooler").
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# https://www.strava.com/settings/api
# Set the app's "Authorization Callback Domain" to `localhost` for local dev,
# and to your Vercel domain in production.
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""

# Public origin of this deployment. The OAuth redirect URI is derived as
# $APP_URL/api/strava/callback.
APP_URL="http://localhost:3000"

# Shared secret gating the single-user OAuth entrypoint (min 16 chars).
# Generate one: openssl rand -hex 24
ADMIN_TOKEN=""

# Garmin Connect (unofficial API — your normal login).
# Used only by the local daily-metrics sync; never sent anywhere but Garmin.
GARMIN_EMAIL=""
GARMIN_PASSWORD=""
